# ===================================================
# APP CORE
# ===================================================
NEXT_PUBLIC_APP_NAME=Stockly
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================================
# SUPABASE
# ===================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===================================================
# HEALTHCHECKS & SAFETY (SPRINT 1)
# ===================================================
HEALTHCHECK_TOKEN=generate-a-secure-random-token-here

# Kill Switches (Defaults to false. Set to 'true' or '1' to activate)
KLYVO_DISABLE_MANUAL_SYNCS=false
KLYVO_DISABLE_AI_WRITES=false
KLYVO_DISABLE_MELI_WRITES=false
KLYVO_DISABLE_WHATSAPP_AGENT=false

# ===================================================
# MERCADO LIBRE
# ===================================================
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:3000/api/meli/callback

# ===================================================
# MERCADO PAGO
# ===================================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ===================================================
# WHATSAPP CLOUD API
# ===================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ===================================================
# AI & LLM PROVIDERS
# ===================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini

# ===================================================
# SENTRY OBSERVABILITY
# ===================================================
NEXT_PUBLIC_SENTRY_DSN=

# ===================================================
# CRON / INNGEST
# ===================================================
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ===================================================
# STORAGE & LOCALIZATION
# ===================================================
SUPABASE_BUCKET_AUDIO=audio-files
SUPABASE_BUCKET_FILES=uploads
DEFAULT_CURRENCY=ARS
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
